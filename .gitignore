# --- added by /safeguard ---
# Things that should never be backed up: operating-system noise, temporary files,
# application caches, and anything that looks like a password.

# Operating system
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Office / creative app lock and autosave files
~$*
*.tmp
*.temp
*.bak
*.autosave
*.blend1
*.blend2
*.blend3
*.psb~
*.aep.bk*
Adobe Premiere Pro Auto-Save/
Adobe After Effects Auto-Save/
*.prlock
*.cfa
*.pek

